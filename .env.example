# Identifiants Sarool
SAROOL_EMAIL=ton.email@exemple.com
SAROOL_PASSWORD=ton_mot_de_passe

# ntfy.sh — notifications push sur ton téléphone
# Choisis un nom unique et random (ex: sarool_thomas_x7k2)
# Pas besoin de créer un compte sur ntfy.sh
NTFY_TOPIC=sarool_thomas_x7k2

# Réservation automatique : true pour réserver auto, false pour notification seulement
AUTO_BOOK=true

# Intervalle de vérification en minutes (défaut: 5)
CHECK_INTERVAL_MINUTES=5

# Chemin des browsers Playwright
PLAYWRIGHT_BROWSERS_PATH=/Users/thomasfilhol/.playwright
